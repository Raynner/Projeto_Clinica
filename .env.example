# Desenvolvimento local. Em produção, APP_ORIGIN obrigatoriamente usa HTTPS.
NODE_ENV=development
PORT=5000
BIND_HOST=127.0.0.1
APP_ORIGIN=http://localhost:5000
# IPs/redes CIDR dos proxies confiáveis separados por vírgula; nunca use true ou 1.
TRUSTED_PROXIES=
# No Railway use x-real-ip e configure os peers confiáveis acima.
CLIENT_IP_HEADER=x-forwarded-for

DB_HOST=localhost
# Conta exclusiva criada no MySQL, sem root, DDL ou GRANT OPTION.
DB_USER=praxis_app
# Gere um segredo aleatório de pelo menos 24 caracteres; não versione o .env real.
DB_PASSWORD=
DB_NAME=
DB_PORT=3306
# Obrigatório para MySQL remoto, com validação do certificado.
DB_TLS=false
# Caminho da CA pública relativo à pasta de execução (ou caminho absoluto).
# Railway, executando na raiz: certificates/railway-mysql-ca.pem
# O certificado do servidor também deve identificar o nome usado em DB_HOST.
DB_SSL_CA=
